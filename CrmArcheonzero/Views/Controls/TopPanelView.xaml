<UserControl x:Class="CrmArcheonzero.Views.Controls.TopPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:CrmArcheonzero.ViewModels">

    <Border Background="{DynamicResource SoftBackground}" 
            Padding="16" 
            CornerRadius="12" 
            Margin="0,0,0,12" 
            BorderBrush="{DynamicResource BorderSoft}" 
            BorderThickness="1"
            Effect="{StaticResource ShadowEffect}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" 
                       Text="CRM Archeonzero" 
                       FontSize="20" 
                       FontWeight="SemiBold" 
                       Foreground="{DynamicResource AccentDeepBlue}" 
                       VerticalAlignment="Center"/>

            <WrapPanel Grid.Column="1" 
                       HorizontalAlignment="Left" 
                       Margin="20,0,0,0" 
                       Visibility="{Binding IsAuthenticated, Converter={StaticResource BoolToVisibility}}">

                <StackPanel Orientation="Horizontal" Margin="10,0">
                    <TextBlock Text="Формат:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <ComboBox Width="60" Margin="0,0,5,0"
                              ItemsSource="{Binding ExportFormats}"
                              SelectedItem="{Binding SelectedExportFormat}" />
                    <Button Content="Export" Command="{Binding ExportCommand}" 
                            Margin="2" Padding="8,4" Style="{DynamicResource AccentButton}"/>
                </StackPanel>
                <Button Content="🎂 ДР" 
                        Command="{Binding ShowBirthdaysCommand}" 
                        Margin="3" Padding="8,4" 
                        Style="{DynamicResource AccentButton}"/>
                <Button Content="📧 Email" 
                        Command="{Binding SendEmailCommand}" 
                        Margin="3" Padding="8,4" 
                        Style="{DynamicResource AccentButton}"/>
                <Button Content="📱 Telegram" 
                        Command="{Binding SendTelegramCommand}" 
                        Margin="3" Padding="8,4" 
                        Style="{DynamicResource AccentButton}"/>
                <Button Content="☁️ Backup" 
                        Command="{Binding BackupToCloudCommand}" 
                        Margin="3" Padding="8,4" 
                        Style="{DynamicResource AccentButton}"/>
                <CheckBox Content="Мои клиенты" 
                          IsChecked="{Binding ShowMyClientsOnly, UpdateSourceTrigger=PropertyChanged}"
                          Margin="10,0,0,0"
                          VerticalAlignment="Center"/>
                <Separator Margin="5,0" Width="1" Background="{DynamicResource BorderSoft}"/>
                <Button Content="🔑 Сменить пароль" 
                        Command="{Binding ChangePasswordCommand}" 
                        Margin="3" Padding="8,4" 
                        Style="{DynamicResource FlatButton}"/>
            </WrapPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{Binding CurrentUser.FullName, StringFormat='Меню Администратора — {0}'}" 
                           Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVisibility}}"
                           VerticalAlignment="Center" Margin="10,0" FontWeight="SemiBold" 
                           Foreground="{DynamicResource TextDark}"/>
                <TextBlock Text="{Binding CurrentUser.FullName}" 
                           Visibility="{Binding IsAuthenticated, Converter={StaticResource BoolToVisibility}}"
                           VerticalAlignment="Center" Margin="10,0" FontWeight="SemiBold" 
                           Foreground="{DynamicResource TextDark}"/>
                <Button Content="🔐 Войти" 
                        Command="{Binding LoginCommand}" 
                        Style="{DynamicResource LoginButton}"
                        Visibility="{Binding IsAuthenticated, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}"/>
                <Button Content="🚪 Выйти" 
                        Command="{Binding LogoutCommand}" 
                        Style="{DynamicResource DangerButton}"
                        Visibility="{Binding IsAuthenticated, Converter={StaticResource BoolToVisibility}}"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>